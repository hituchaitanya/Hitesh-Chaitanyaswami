seed: 42
device: cuda

# dataset
data:
  train_dir: data/train
  val_dir: data/val
  test_dir: data/test
  batch_size: 8
  num_workers: 4
  img_size: [512, 512]

# preprocessing
preproc:
  contrast_clip_limit: 2.0
  clahe_tile: [8,8]
  denoise_h: 10

# segmentation model
seg:
  model: unet
  in_channels: 1
  out_channels: 1
  base_channels: 32
  pretrained: False

# recognition model
rec:
  model: crnn
  img_h: 32
  num_channels: 1
  num_classes: 80  # adjust to your charset size
  hidden_size: 256

# training
training:
  epochs: 60
  lr: 1e-3
  weight_decay: 1e-5
  save_every: 5
  checkpoint_dir: weights
